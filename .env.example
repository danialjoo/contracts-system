# ---- پایگاه داده ----
POSTGRES_USER=contracts
POSTGRES_DB=contracts
# با دستور زیر بسازید:  openssl rand -base64 24
POSTGRES_PASSWORD=

# ---- برنامه ----
# با دستور زیر بسازید:  openssl rand -base64 48
APP_SECRET_KEY=

# اگر جلوی سامانه TLS گذاشتید این را true کنید.
APP_COOKIE_SECURE=false

APP_MAX_UPLOAD_MB=20
APP_EXPIRING_DAYS=90

# ---- کاربر مدیر اولیه ----
# اگر خالی بماند، رمز تصادفی ساخته و در لاگ اولین اجرا چاپ می‌شود.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# ---- شبکه ----
# آدرس داخلی سرور. برای دسترسی کاربران شبکه، IP شبکه محلی سرور را بگذارید.
# مثال: BIND_ADDR=192.168.10.25
BIND_ADDR=127.0.0.1
HTTP_PORT=8080
